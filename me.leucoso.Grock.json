{
    "app-id": "me.leucoso.Grock",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "grock",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.GeoClue2",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/libexec",
        "/man",
        "/share/doc",
        "/share/gir-1.0",
        "/share/gtk-doc",
        "/share/installed-tests",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/clutter/clutter.json",
        "shared-modules/libsoup/libsoup-2.4.json",
        {
            "name" : "libchamplain",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://codeberg.org/dburgess/libchamplain-wms.git",
                    "tag" : "v1.0.0",
                    "commit" : "ec6cc2f9d85a2295df7684aa1ed28d077e36cdeb"
                }
            ]
        },
        {
            "name" : "geocode-glib",
            "buildsystem" : "meson",
            "builddir" : true,
            "config-opts" : [
                "-Denable-gtk-doc=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
                    "sha256" : "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa"
                }
            ]
        },
        {
            "name" : "proj",
            "buildsystem" : "cmake-ninja",
            "build-options": {
                "cxxflags": "-Wno-error=implicit-function-declaration"
            },
            "config-opts" : [
                "-DBUILD_TESTING=OFF"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/OSGeo/PROJ/releases/download/9.7.1/proj-9.7.1.tar.gz",
                    "sha256" : "6c097dc803c561929cdfcc46e4bf9945ea977611fb31493ad14e88edaeae260f"
                }
            ]
        },
        {
            "name": "grock",
            "builddir": true,
            "buildsystem": "meson",
            "build-options": {
                "cflags": "-Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"
            },
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/dburgess/Grock.git",
                    "tag": "v1.0.0",
                    "commit": "7a3bc912048e38013e8f77ffca4bc23532a4d2dc"
                },
                {
                    "type": "patch",
                    "path": "screenshot-url.patch"
                }
            ]
        }
    ]
}
